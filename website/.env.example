# Stripe API Keys
# Get your keys from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Application URL
NEXT_PUBLIC_APP_URL=https://www.harnesscart.com

# Stripe webhook (create in Stripe Dashboard → Developers → Webhooks)
# Endpoint: https://www.harnesscart.com/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Firebase Admin (server-side orders, quotes, contact form)
# Paste the full service account JSON as a single line from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: email notifications via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Harness Cart <onboarding@resend.dev>

# Firebase — project: harnesscart
# Console: https://console.firebase.google.com/project/harnesscart
# Copy this block to .env.local for local dev, and set the same keys in Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=harnesscart.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=harnesscart
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=harnesscart.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Admin (god mode) — comma-separated emails granted admin access, in addition
# to the built-in allowlist in lib/admin.ts
NEXT_PUBLIC_ADMIN_EMAILS=

# Shipping carriers (North America). Each carrier is optional — checkout
# falls back to table rates when none are configured.

# UPS — https://developer.ups.com (OAuth client credentials + shipper number)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# Use https://wwwcie.ups.com for the UPS sandbox
# UPS_API_BASE=https://onlinetools.ups.com

# FedEx — https://developer.fedex.com (OAuth client credentials + account number)
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
# Use https://apis-sandbox.fedex.com for the FedEx sandbox
# FEDEX_API_BASE=https://apis.fedex.com

# USPS — https://developers.usps.com (OAuth client credentials, US domestic only)
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Use https://apis-tem.usps.com for the USPS test environment
# USPS_API_BASE=https://apis.usps.com
